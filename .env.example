# =============================================================================
# 环境变量模板
# 复制此文件为 .env 并填入真实值
# =============================================================================

# 必填：DeepSeek API Key
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 可选：阿里云 DashScope API Key（嵌入 + 重排序，未设置则重排序不可用）
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# 可选：LLM 模型配置
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT=120

# 可选：Embedding 模型
EMBEDDING_MODEL=text-embedding-v4

# 可选：功能开关
ENABLE_RAG=true
ENABLE_INTERACTIVE_COMPLETION=false

# 可选：调试
DEBUG=false
LOG_LEVEL=INFO